# Credencial de la API de Anthropic. Requerida: sin ella /api/chat responde 503.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo del asistente. Sonnet 5.5 es el valor por defecto de api/chat.js.
# El anterior (claude-haiku-4-5-20251001) fue retirado por Anthropic el 15/10/2026.
ANTHROPIC_MODEL=claude-sonnet-5-5

# low | medium | high. low mantiene el costo por consulta acotado; el thinking
# between_tools consume max_tokens, asi que subirlo obliga a subir MAX_TOKENS.
ANTHROPIC_EFFORT=low

# Consultas por IP permitidas en una ventana de 60 s. 0 desactiva el limite.
CHAT_RATE_LIMIT=8