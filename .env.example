# Proveedor del asistente de ayuda: gemini (por defecto) o anthropic.
# El canal de ayuda usa Gemini porque su free tier no cobra y no pide tarjeta.
CHAT_PROVIDER=gemini

# Token secreto para el inventario compartido y el Excel. Usá una cadena larga.
ADMIN_TOKEN=

# Credencial de la API de Google. Se consigue gratis, sin tarjeta, en
# https://aistudio.google.com/apikey
# Sin ella /api/chat responde 503.
GEMINI_API_KEY=

# Modelo del asistente.
# Medido contra la API real: 3.5-flash-lite responde en ~0.8 s de forma
# sostenida. Los flash más nuevos (3.6, 3.8) devuelven 503 "high demand" en el
# free tier, y 2.5-flash / 2.5-flash-lite ya no existen para cuentas nuevas
# (404 "no longer available to new users"). La capacidad va y viene, así que si
# el canal empieza a fallar, corré `npm run check:modelos`.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Alternativa con Anthropic -----------------------------------------------
# Para usarla, comentá CHAT_PROVIDER=gemini y poné CHAT_PROVIDER=anthropic.
# Anthropic no tiene free tier: cobra por token y exige tarjeta y saldo.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high. low mantiene el costo acotado; el thinking between_tools
# consume max_tokens, así que subirlo obliga a subir MAX_TOKENS.
# ANTHROPIC_EFFORT=low

# Consultas por IP permitidas en una ventana de 60 s. El default del código es 12.
# Ojo: poner 0 NO desactiva el límite, cae en 12. Para dejar el canal sin límite
# por IP hay que editar checkRateLimit() en api/chat.js.
CHAT_RATE_LIMIT=12
