{
  "name": "lotus-panol-kiosk",
  "version": "2.4.0",
  "private": true,
  "description": "Terminal de herramientas L.O.T.U.S. — kiosco de NFC y código de barras para pañol industrial",
  "scripts": {
    "build": "tailwindcss -i ./src/tailwind.css -o ./assets/lotus.css --minify",
    "dev": "tailwindcss -i ./src/tailwind.css -o ./assets/lotus.css --watch",
    "check": "npm run build && node scripts/check-css-coverage.mjs && node scripts/check-inline-js.mjs && node scripts/audit-tailwind-parity.mjs && node scripts/test-chat.mjs",
    "test": "node scripts/test-chat.mjs && node scripts/test-chat-ui.mjs",
    "test:chat": "node scripts/test-chat.mjs",
    "test:ui": "node scripts/test-chat-ui.mjs",
    "check:css": "node scripts/check-css-coverage.mjs",
    "check:js": "node scripts/check-inline-js.mjs",
    "check:parity": "node scripts/audit-tailwind-parity.mjs",
    "check:render": "node scripts/verify-render.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "tailwindcss": "^4.1.13"
  }
}
